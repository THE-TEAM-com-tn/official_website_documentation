{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "TheTeam API",
  "description": "Public HTTP API of the TheTeam website backend (admin.theteam.com.tn): trainings, blog, Knowledge Corner, site content and public forms.",
  "colors": {
    "primary": "#259D79",
    "light": "#3CC49A",
    "dark": "#1E7F62"
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "/"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "heading": {
      "family": "Outfit"
    },
    "body": {
      "family": "Inter"
    }
  },
  "appearance": {
    "default": "system"
  },
  "api": {
    "mdx": {
      "server": "https://admin.theteam.com.tn/api"
    },
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "autogenerate": false
    },
    "params": {
      "expanded": "all"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index"
            ]
          },
          {
            "group": "Core concepts",
            "pages": [
              "concepts/authentication",
              "concepts/localization",
              "concepts/responses-and-errors",
              "concepts/pagination",
              "concepts/rate-limits",
              "concepts/publishing-and-caching"
            ]
          },
          {
            "group": "Security",
            "pages": [
              "security/php2shell",
              "security/client-ip-and-rate-limits",
              "security/cloudflare-and-proxies"
            ]
          },
          {
            "group": "Troubleshooting",
            "pages": [
              "troubleshooting/forms-cors-preflight"
            ]
          }
        ]
      },
      {
        "tab": "Content",
        "groups": [
          {
            "group": "Trainings",
            "pages": [
              "api-reference/trainings/overview",
              "api-reference/trainings/list",
              "api-reference/trainings/get",
              "api-reference/trainings/options",
              "api-reference/trainings/categories"
            ]
          },
          {
            "group": "Blog",
            "pages": [
              "api-reference/blog/overview",
              "api-reference/blog/list-posts",
              "api-reference/blog/pinned-posts",
              "api-reference/blog/get-post",
              "api-reference/blog/list-categories"
            ]
          },
          {
            "group": "Knowledge Corner",
            "pages": [
              "api-reference/articles/overview",
              "api-reference/articles/list",
              "api-reference/articles/filters",
              "api-reference/articles/pinned",
              "api-reference/articles/get"
            ]
          },
          {
            "group": "Site content",
            "pages": [
              "api-reference/content/overview",
              "api-reference/content/landing-page",
              "api-reference/content/list-testimonials",
              "api-reference/content/pinned-testimonials",
              "api-reference/content/list-webinars",
              "api-reference/content/list-faqs",
              "api-reference/content/list-pages",
              "api-reference/content/get-page",
              "api-reference/content/list-menu",
              "api-reference/content/get-menu-item"
            ]
          }
        ]
      },
      {
        "tab": "Forms",
        "groups": [
          {
            "group": "Forms",
            "pages": [
              "api-reference/forms/overview"
            ]
          },
          {
            "group": "Contact, enrollment and quotes",
            "pages": [
              "api-reference/forms/contact-us",
              "api-reference/forms/create-enrollment",
              "api-reference/forms/create-devis"
            ]
          },
          {
            "group": "Newsletter",
            "pages": [
              "api-reference/forms/newsletter-subscribe",
              "api-reference/forms/newsletter-unsubscribe"
            ]
          },
          {
            "group": "Réclamations",
            "pages": [
              "api-reference/forms/create-reclamation",
              "api-reference/forms/track-reclamation"
            ]
          },
          {
            "group": "Reviews and testimonials",
            "pages": [
              "api-reference/forms/create-review",
              "api-reference/forms/list-reviews",
              "api-reference/forms/submit-testimonial"
            ]
          }
        ]
      },
      {
        "tab": "Authentication",
        "groups": [
          {
            "group": "Tokens and devices",
            "pages": [
              "api-reference/auth/overview",
              "api-reference/auth/login",
              "api-reference/auth/get-user",
              "api-reference/auth/logout",
              "api-reference/auth/list-devices",
              "api-reference/auth/revoke-device",
              "api-reference/auth/logout-all"
            ]
          },
          {
            "group": "Password and verification",
            "pages": [
              "api-reference/auth/update-password",
              "api-reference/auth/forgot-password",
              "api-reference/auth/reset-password",
              "api-reference/auth/verify-email",
              "api-reference/auth/resend-verification"
            ]
          },
          {
            "group": "Email change",
            "pages": [
              "api-reference/email-change/overview",
              "api-reference/email-change/get-pending",
              "api-reference/email-change/start",
              "api-reference/email-change/resend",
              "api-reference/email-change/discard",
              "api-reference/email-change/confirm",
              "api-reference/email-change/cancel"
            ]
          }
        ]
      },
      {
        "tab": "System",
        "groups": [
          {
            "group": "System",
            "pages": [
              "api-reference/system/overview",
              "api-reference/system/health",
              "api-reference/system/status-page"
            ]
          },
          {
            "group": "Share pages and sitemaps",
            "pages": [
              "api-reference/web/share-blog",
              "api-reference/web/share-article",
              "api-reference/web/sitemap-trainings",
              "api-reference/web/sitemap-articles"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://theteam.com.tn"
      }
    ],
    "primary": {
      "type": "button",
      "label": "API status",
      "href": "https://admin.theteam.com.tn/"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode"
    ]
  },
  "seo": {
    "indexing": "navigable",
    "metatags": {
      "robots": "noindex, nofollow, noarchive, nosnippet, noimageindex"
    }
  }
}
